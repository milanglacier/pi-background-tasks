{
	"name": "@milanglacier/pi-background-tasks",
	"version": "0.7.0",
	"description": "Reactive background shell tasks for pi with /bg, Ctrl+Shift+B, log viewing, and agent wakeups on output.",
	"keywords": [
		"automation",
		"background-tasks",
		"pi",
		"pi-coding-agent",
		"pi-package",
		"shell",
		"watch"
	],
	"homepage": "https://github.com/milanglacier/pi-background-tasks",
	"bugs": {
		"url": "https://github.com/milanglacier/pi-background-tasks/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/milanglacier/pi-background-tasks.git"
	},
	"type": "module",
	"files": [
		"index.ts",
		"background-tasks-shared.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "npm run typecheck && npm run test",
		"typecheck": "tsc --project ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.87.0 <=0.100.0",
